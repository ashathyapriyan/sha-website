<section class="cat-hero" style="--accent: {{accent}}">
  <div class="cat-hero-inner">
    <span class="cat-hero-label">👤 Portfolio</span>
    <p>{{description}}</p>
  </div>
</section>

<section class="section">
  <div class="section-head"><h2>Projects</h2></div>
  <div class="card-grid">
    {{#each projects}}
      <a href="{{this.url}}" class="card project-card">
        <div class="card-body">
          <span class="project-emoji">{{this.emoji}}</span>
          <h3 class="card-title">{{this.name}}</h3>
          <p class="card-excerpt">{{this.description}}</p>
          <div class="project-tech">
            {{#each this.tech}}<span class="tech-pill">{{this}}</span>{{/each}}
          </div>
        </div>
      </a>
    {{/each}}
  </div>
</section>

<section class="section section--alt">
  <div class="section-head"><h2>Skills</h2></div>
  <div class="skills">
    {{#each skills}}
      <div class="skill">
        <div class="skill-top"><span>{{this.name}}</span><span>{{this.level}}%</span></div>
        <div class="skill-bar"><div class="skill-fill" style="width: {{this.level}}%"></div></div>
      </div>
    {{/each}}
  </div>
</section>
